# =========================================================================
# Brainware Academic AI - Server Environment Configuration
# =========================================================================

# 1. Google Gemini Configuration (Recommended Free Tier Available)
# Obtain a 100% free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenAI Configuration (Optional: Enables GPT-4o / GPT-4o-mini inference)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Custom OpenAI-Compatible Base URL (Optional: For Groq, OpenRouter, Ollama, vLLM)
# Examples:
# Groq:        https://api.groq.com/openai/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Local Ollama:http://localhost:11434/v1
OPENAI_BASE_URL=

# 4. Backend Network Configuration (Default: Port 5000)
PORT=5000
HOST=0.0.0.0
